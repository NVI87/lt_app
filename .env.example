# *************************************************************** kafka_event_generator
KAFKA_EVENT_GENERATOR_SOURCE_CSV_PATH=./export-lt-all-types-1.csv

KAFKA_EVENT_GENERATOR_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENT_GENERATOR_TARGET_TOPIC=intel-assist-index-test-etl-11
KAFKA_EVENT_GENERATOR_CONSUMER_GROUP_ID=etl-consumer-test-1070

KAFKA_EVENT_GENERATOR_MAX_LAG=3
KAFKA_EVENT_GENERATOR_MAX_MESSAGES=18
KAFKA_EVENT_GENERATOR_LAG_CONTROL_ENABLED=true
KAFKA_EVENT_GENERATOR_LAG_CHECK_INTERVAL_SEC=1
KAFKA_EVENT_GENERATOR_LAG_CHECK_EVERY_MESSAGES=1

KAFKA_EVENT_GENERATOR_REPEAT_SOURCE=false
KAFKA_EVENT_GENERATOR_PRESERVE_SOURCE_PARTITION=false
KAFKA_EVENT_GENERATOR_TIMESTAMP_MODE=broker
KAFKA_EVENT_GENERATOR_MESSAGE_DELAY_SEC=0

KAFKA_EVENT_GENERATOR_SECURITY_PROTOCOL=PLAINTEXT

# Для SASL_SSL, только в локальном .env:
# KAFKA_EVENT_GENERATOR_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_EVENT_GENERATOR_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_EVENT_GENERATOR_SASL_USERNAME=...
# KAFKA_EVENT_GENERATOR_SASL_PASSWORD=...
# KAFKA_EVENT_GENERATOR_SSL_CAFILE=/path/to/ca.pem


# *************************************************************** opensearch_index_monitor
# OpenSearch index monitor
OPENSEARCH_INDEX_MONITOR_HOST=localhost
OPENSEARCH_INDEX_MONITOR_PORT=9204

# Реальные значения задавать только в локальном .env или environment.
OPENSEARCH_INDEX_MONITOR_USERNAME=
OPENSEARCH_INDEX_MONITOR_PASSWORD=

# Pydantic ожидает JSON-массив.
OPENSEARCH_INDEX_MONITOR_INDEX_NAMES=["attachment_etl_release_tst","attachment_knowledge_chunk_etl_release_tst_lt_0","knowledge_chunk_etl_release_tst_lt_0","knowledge_etl_release_tst_lt_0"]

OPENSEARCH_INDEX_MONITOR_OUTPUT_CSV_PATH=./artifacts/index_counts.csv
OPENSEARCH_INDEX_MONITOR_POLL_INTERVAL_SEC=1
OPENSEARCH_INDEX_MONITOR_REQUEST_TIMEOUT_SEC=10

OPENSEARCH_INDEX_MONITOR_USE_SSL=false
OPENSEARCH_INDEX_MONITOR_VERIFY_CERTS=false
OPENSEARCH_INDEX_MONITOR_SSL_ASSERT_HOSTNAME=false
OPENSEARCH_INDEX_MONITOR_SSL_SHOW_WARN=false

# Только если используется корпоративный/self-signed CA:
# OPENSEARCH_INDEX_MONITOR_CA_CERTS_PATH=/absolute/path/to/ca.pem


# *************************************************************** kafka_json_artifact_collector
# Kafka diagnostic JSON artifact collector

KAFKA_ARTIFACT_COLLECTOR_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ARTIFACT_COLLECTOR_TOPIC=intel-assist-index-errors-loc

# Должна быть отдельной от группы тестируемого ETL-сервиса.
# Для новой тестовой сессии логично создавать уникальный suffix session_id.
KAFKA_ARTIFACT_COLLECTOR_CONSUMER_GROUP_ID=lt-artifact-collector-local

# Не корень репозитория: debug-события могут быть очень большими.
KAFKA_ARTIFACT_COLLECTOR_OUTPUT_DIRECTORY=./artifacts/err_events

# earliest — забрать всю доступную retained-историю при новой group.
# latest — собирать только события, появившиеся после старта collector-а.
KAFKA_ARTIFACT_COLLECTOR_AUTO_OFFSET_RESET=earliest

# Пусто = работать до команды Stop.
# KAFKA_ARTIFACT_COLLECTOR_MAX_MESSAGES=1000

KAFKA_ARTIFACT_COLLECTOR_POLL_TIMEOUT_MS=1000
KAFKA_ARTIFACT_COLLECTOR_SECURITY_PROTOCOL=PLAINTEXT

# Для SASL_SSL — только в локальном .env:
# KAFKA_ARTIFACT_COLLECTOR_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_ARTIFACT_COLLECTOR_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_ARTIFACT_COLLECTOR_SASL_USERNAME=...
# KAFKA_ARTIFACT_COLLECTOR_SASL_PASSWORD=...
# KAFKA_ARTIFACT_COLLECTOR_SSL_CAFILE=/path/to/ca.pem


# *************************************************************** etl_report_statistics
# ETL report statistics builder

# Каталог, который заполняет KafkaArtifactCollector.
ETL_REPORT_STATISTICS_SOURCE_DIRECTORY=./artifacts/err_events

# CSV-артефакты одной тестовой сессии.
ETL_REPORT_STATISTICS_DONE_OUTPUT_CSV_PATH=./artifacts/stats_done.csv
ETL_REPORT_STATISTICS_SKIPPED_OUTPUT_CSV_PATH=./artifacts/stats_skipped.csv
ETL_REPORT_STATISTICS_READ_FAILURES_OUTPUT_CSV_PATH=./artifacts/stats_read_failures.csv

ETL_REPORT_STATISTICS_REPORT_GLOB=*.json
ETL_REPORT_STATISTICS_INCLUDE_PAGE_BODY_ROWS=true
ETL_REPORT_STATISTICS_SORT_REPORTS_BY_NAME=true


# *************************************************************** etl_statistics_projection.py
# ETL statistics projection builder

# Результат EtlReportStatisticsBuilder.
ETL_STATISTICS_PROJECTION_SOURCE_DONE_CSV_PATH=./artifacts/stats_done.csv

# Финальные аналитические артефакты сессии.
ETL_STATISTICS_PROJECTION_COEFFICIENTS_OUTPUT_CSV_PATH=./artifacts/coefficients.csv
ETL_STATISTICS_PROJECTION_STAGE_PROJECTION_OUTPUT_CSV_PATH=./artifacts/projection_by_stage.csv
ETL_STATISTICS_PROJECTION_TOTAL_PROJECTION_OUTPUT_CSV_PATH=./artifacts/projection_total.csv

# JSON-массив размеров вложений в мегабайтах.
ETL_STATISTICS_PROJECTION_TARGET_SIZES_MB=[1,5,10,25,50,100,200,500,1000]

# При единственной точке допускается грубая модель y = a * x.
ETL_STATISTICS_PROJECTION_ALLOW_SINGLE_POINT_ORIGIN_FIT=true

# Не позволять линейной модели выдать отрицательное время или RSS.
ETL_STATISTICS_PROJECTION_CLAMP_NEGATIVE_PREDICTIONS=true
